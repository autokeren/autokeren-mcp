{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.autokeren/mcp",
  "title": "AutoKeren MCP",
  "description": "AI video studio for agents \u2014 script to MP4, b-roll sourcing, Gemini QA. 42 tools.",
  "version": "1.1.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.autokeren.com",
      "headers": [
        {
          "name": "Authorization",
          "description": "API key \u2014 get yours at https://studio.autokeren.com/settings",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "value": "Bearer ak_YOUR_KEY",
          "placeholder": "Bearer ak_YOUR_KEY"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/autokeren/autokeren-mcp",
    "source": "github",
    "id": "1394627344"
  },
  "website_url": "https://mcp.autokeren.com",
  "icons": [
    {
      "src": "https://autokeren.com/logo_ak.jpg",
      "mimeType": "image/jpeg",
      "sizes": [
        "any"
      ]
    }
  ]
}